# Python bytecode and build artefacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / agent state
.vscode/
.kilo/
.omo/
.directory

# Dependencies
node_modules/

# package-lock.json is deliberately NOT ignored: the adblock engine
# resolves @ghostery/adblocker from node_modules, and the lock file is
# what makes `npm ci` reproduce the tree a fresh clone needs.

# Runtime state written into the repo tree
*.log
bfsb_checkup.sh.lock

# Generated local search index (rebuilt by the crawler)
data/index.db
data/index.db-shm
data/index.db-wal
data/crawled/

# Dependency cache populated by scripts/cache_deps.sh. Deliberately not
# committed: it is a mirror of PyPI and npm, and it is large. The directory
# itself is kept (via .gitkeep) so the Dockerfile's COPY always resolves on a
# plain clone; the build works with or without the contents.
vendor/*
!vendor/.gitkeep
