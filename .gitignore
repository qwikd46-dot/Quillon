# Python bytecode and build artefacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / agent state
.vscode/
.kilo/
.omo/
.directory

# Dependencies
node_modules/

# package-lock.json is deliberately NOT ignored: the adblock engine
# resolves @ghostery/adblocker from node_modules, and the lock file is
# what makes `npm ci` reproduce the tree a fresh clone needs.

# Runtime state written into the repo tree
*.log
quillon_checkup.sh.lock

# One-off debugging scratch, kept on disk but never in history. These are
# throwaway scripts that poke at a running instance, not part of the
# project; committing them makes the rename and the test suite noisier
# for no benefit.
find_brace.py
verify_fix.py
verify_script.py
test_css.py
test_playwright.py
test_tab_animations.py
screenshots/

# Stale file from before the Quillon work: a 675-line main_window.py
# snapshot dated Jul 8 that predates all of it and is not the current
# implementation. Predates the rename, kept on disk, out of the index.
quillon/ui/main_window.py.my_changes

# Generated local search index (rebuilt by the crawler)
data/index.db
data/index.db-shm
data/index.db-wal
data/crawled/

# Dependency cache populated by scripts/cache_deps.sh. Deliberately not
# committed: it is a mirror of PyPI and npm, and it is large. The directory
# itself is kept (via .gitkeep) so the Dockerfile's COPY always resolves on a
# plain clone; the build works with or without the contents.
vendor/*
!vendor/.gitkeep

# searxng-git is a nested git checkout of SearXNG's AUR packaging. It was
# committed as a gitlink (mode 160000) with no .gitmodules entry, which makes
# `actions/checkout` fail with "No url found for submodule path" and took the
# whole image build down with it. Nothing references it: the image clones
# SearXNG itself. Kept on disk, out of the index.
searxng-/searxng-git/
