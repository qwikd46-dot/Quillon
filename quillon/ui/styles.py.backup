# ═══════════════════════════════════════════════════════════════

TAB_BAR = f"""
    QWidget {{
        {_bg(C.BG_1)}
        border-bottom: 1px solid {C.BORDER_0};
    }}
"""

SCROLL_AREA = f"""
    QScrollArea {{
        {_bg("transparent")}
        border: none;
        background: transparent;
    }}
    QScrollBar:vertical {{ width: 0px; }}
    QScrollBar:horizontal {{ height: 0px; }}
"""

NAV_BAR = f"""
